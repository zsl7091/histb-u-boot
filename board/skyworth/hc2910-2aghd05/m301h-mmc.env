# 1. 扫描介质顺序：优先扫描 USB 0，再扫描 eMMC 0
boot_targets=mmc0 usb0

# 2. 必须与 extlinux 解析器的默认寻找路径完全一致
kernel_addr_r=0x08000000
fdt_addr_r=0x0e000000
ramdisk_addr_r=0x0f000000
scriptaddr=0x09000000
pxefile_addr_r=0x0a000000

# 3. 串口与终端默认参数（会被 extlinux.conf 中的 APPEND 覆盖或补充）
console=ttyAMA0,115200

# 4. 自动化启动逻辑（先尝试从 blkmap 读取内核与 DTB 启动，失败则回退到 U盘 sysboot）
bootcmd=mmc dev 0; blkmap destroy bootfs; blkmap create bootfs; blkmap map bootfs 0 0x10000 linear mmc 0 0x1000; blkmap get bootfs dev bmdev; sysboot blkmap ${bmdev} any ${scriptaddr} /boot/extlinux/extlinux.conf; usb start; sysboot usb 0:1 any ${scriptaddr} /boot/extlinux/extlinux.conf
