bootdelay=2
scriptaddr=0x09000000
kernel_addr_r=0x08000000
fdt_addr_r=0x0e000000

boot_emmc=mmc dev 0; blkmap destroy bootfs; blkmap create bootfs; blkmap map bootfs 0 0x10000 linear mmc 0 0x1000; blkmap get bootfs dev bmdev; sysboot blkmap ${bmdev} any ${scriptaddr} /boot/extlinux/extlinux.conf

boot_usb=usb start; sysboot usb 0:1 any ${scriptaddr} /boot/extlinux/extlinux.conf

# 有 force_usb 则 USB，否则 eMMC；eMMC 失败再尝试 USB 兜底
bootcmd=mmc dev 0; blkmap destroy bootfs; blkmap create bootfs; blkmap map bootfs 0 0x10000 linear mmc 0 0x1000; blkmap get bootfs dev bmdev; if load blkmap ${bmdev} ${scriptaddr} /boot/force_usb; then run boot_usb; else run boot_emmc; fi; run boot_usb
